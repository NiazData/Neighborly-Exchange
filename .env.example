# Supabase project (Settings → API in the Supabase dashboard)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Feature flags
VITE_PHONE_VERIFICATION=off

# Minutes of inactivity before auto-logout (default 10 if unset)
VITE_IDLE_TIMEOUT_MINUTES=10

# Canonical site URL for SEO meta + sitemap (set in Netlify env on deploy)
VITE_SITE_URL=https://neighbourly-exchange.netlify.app

# Seeding (scripts/seed.mjs) is LOCAL-ONLY and takes its credentials as
# run-time env vars — never store the service-role key in any file:
#   SUPABASE_URL=... SUPABASE_SERVICE_ROLE_KEY=... node scripts/seed.mjs
